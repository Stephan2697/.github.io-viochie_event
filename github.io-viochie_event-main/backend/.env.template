# ============================================================================
# Viochie Events Backend - Environment Configuration
# ============================================================================
# 
# IMPORTANT: 
# - Copy this file to .env (do NOT edit .env.example)
# - Never commit .env to git (it contains passwords)
# - .env is already in .gitignore
#
# ============================================================================

# Server Configuration
# ============================================================================
PORT=5000
NODE_ENV=development

# ============================================================================
# Email Configuration
# ============================================================================

# Gmail Setup (Recommended for development)
# ─────────────────────────────────────────
# Steps:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Windows Computer" (or your device)
# 3. Generate and copy the 16-character password
# 4. Paste below in EMAIL_PASSWORD
# 5. Make sure 2FA is enabled on your Google Account

EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password


# Alternative Email Services
# ─────────────────────────────────────────
# Uncomment and configure for your email service

# Outlook/Hotmail
# EMAIL_SERVICE=outlook
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASSWORD=your-password

# Yahoo
# EMAIL_SERVICE=yahoo
# EMAIL_USER=your-email@yahoo.com
# EMAIL_PASSWORD=your-password

# Custom SMTP Server
# EMAIL_HOST=smtp.your-service.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@your-service.com
# EMAIL_PASSWORD=your-password

# ============================================================================
# Admin & Notification Settings
# ============================================================================

# Email where contact submissions will be sent
ADMIN_EMAIL=info@viochieevents.com

# Frontend URL for CORS (optional, for production)
# FRONTEND_URL=https://yourdomain.com

# ============================================================================
# Optional: Advanced Settings
# ============================================================================

# Uncomment to enable detailed logging
# DEBUG=true

# Uncomment to set custom email from name
# EMAIL_FROM_NAME=Viochie Events

# ============================================================================
# NOTES FOR DIFFERENT ENVIRONMENTS
# ============================================================================

# Development (.env)
# - Use local email service credentials
# - PORT=5000
# - NODE_ENV=development

# Production
# - Use production email service
# - Update ADMIN_EMAIL to production address
# - Set FRONTEND_URL to production domain
# - NODE_ENV=production
# - Use secure passwords
# - Deploy with process manager (PM2, forever, etc)

# ============================================================================
